# Tolatola Client - Environment Variables Configuration
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# The placeholder values below are enough for `npm run build`, `npm run lint`,
# `npm run typecheck` and `npm test` -- none of those touch a live service.
# Real values are only needed to run the app against real auth, payments,
# maps or storage (`npm run dev`).

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# API Base URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=https://api.tolatola.co
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# ClickPesa Payment Integration
# -----------------------------------------------------------------------------
CLICKPESA_API_URL=https://api.clickpesa.com
CLICKPESA_CLIENT_ID=your-clickpesa-client-id
CLICKPESA_API_KEY=your-clickpesa-api-key
NEXT_PUBLIC_CLICKPESA_PUBLIC_FIELDS=

# -----------------------------------------------------------------------------
# Authentication & Tokens
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-key

# Required by POST /api/setup/create-admin, which creates the very first admin
# user. There is no fallback: if this is unset the route refuses the request.
# Generate a strong random value, e.g. `openssl rand -hex 32`.
ADMIN_SETUP_KEY=

# -----------------------------------------------------------------------------
# Google Maps (address autocomplete, geocoding, order tracking map)
# -----------------------------------------------------------------------------
# Server-side only; used by the server actions in app/actions/maps.ts.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Supabase Storage bucket used for uploads (business licenses, KYC documents).
# Defaults to "uploads" when unset.
STORAGE_BUCKET=uploads

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Set automatically by `next dev` / `next build` / `next start`; you normally do
# not set this by hand. lib/logger.ts reads it to pick the default log level.
NODE_ENV=development

# Port the server listens on. Next defaults to 3000; the Dockerfile and
# docker-compose.yml set it explicitly.
PORT=3000

# Minimum log level emitted by lib/logger.ts: debug | info | warn | error.
# Unset means "debug" in development and "info" in production.
NEXT_PUBLIC_LOG_LEVEL=debug
